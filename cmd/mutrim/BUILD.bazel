load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "mutrim_lib",
    srcs = [
        "import.go",
        "main.go",
        "test.go",
    ],
    importpath = "github.com/illumination-k/mutrim/cmd/mutrim",
    visibility = ["//visibility:private"],
    deps = [
        "//criteria",
        "//ingest",
        "//minimize",
        "//mut",
        "//mutator",
        "//report",
        "//runner",
        "@org_golang_x_sync//errgroup",
        "@org_golang_x_tools//go/packages",
        "@rules_go//go/runfiles",
    ],
)

go_binary(
    name = "mutrim",
    embed = [":mutrim_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "mutrim_test",
    srcs = ["import_test.go"],
    embed = [":mutrim_lib"],
    deps = [
        "//ingest",
        "//runner",
    ],
)
