load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//:defs.bzl", "mutation_test")

go_library(
    name = "stats",
    srcs = ["stats.go"],
    importpath = "github.com/illumination-k/mutrim/examples/stats",
    visibility = ["//visibility:public"],
    deps = ["//examples/calc"],
)

go_test(
    name = "stats_test",
    srcs = ["stats_test.go"],
    embed = [":stats"],
    # mutant_calc runs these tests against the mutants of //examples/calc.
    visibility = ["//examples/calc:__pkg__"],
)

mutation_test(
    name = "mutant_stats",
    srcs = ["stats_test.go"],
    confirm_baseline = 2,
    confirm_kills = 2,
    embed = [":stats"],
    exclude_re = "return -> zero values",
    match = "^(Mean|Spread)$",
    operators = [
        "default",
        "-constant",
    ],
)
