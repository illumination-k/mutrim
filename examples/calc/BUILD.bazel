load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//:defs.bzl", "mutation_test")

go_library(
    name = "calc",
    srcs = ["calc.go"],
    importpath = "github.com/illumination-k/mutrim/examples/calc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "calc_test",
    srcs = ["calc_test.go"],
    embed = [":calc"],
)

mutation_test(
    name = "mutant_calc",
    srcs = ["calc_test.go"],
    embed = [":calc"],
    # stats imports calc, so its tests can kill calc's mutants too.
    extra_tests = ["//examples/stats:stats_test"],
    shard_count = 2,
    subtests = True,
    # A gate well under the current score, so the target fails on a
    # regression rather than on the next added mutant.
    threshold = 0.5,
)
