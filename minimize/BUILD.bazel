load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//:defs.bzl", "mutation_test")

go_library(
    name = "minimize",
    srcs = [
        "keep.go",
        "minimize.go",
    ],
    importpath = "github.com/illumination-k/mutrim/minimize",
    visibility = ["//visibility:public"],
    deps = [
        "//criteria",
        "@com_github_bits_and_blooms_bitset//:bitset",
    ],
)

go_test(
    name = "minimize_test",
    srcs = [
        "bench_test.go",
        "minimize_test.go",
    ],
    deps = [
        ":minimize",
        "//criteria",
    ],
)

mutation_test(
    name = "mutant_minimize",
    srcs = ["minimize_test.go"],
    embed = [":minimize"],
    # In-memory tests: a looping mutant need not wait out the 10s default.
    min_timeout = "1s",
    deps = ["//criteria"],
)
